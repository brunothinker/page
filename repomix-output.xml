  --border-accent: rgba(59, 130, 246, 0.45);
  --text-primary: #f4f6fb;
  --text-secondary: #a1a9bd;
  --text-muted: #6b7388;
  --accent: #3b82f6;
  --accent-hover: #2563eb;
  --emerald: #10b981;
  --amber: #f59e0b;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  color-scheme: dark;
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  color: inherit;
}

code,
pre {
  font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.ambient-glow {
  position: fixed;
  top: -180px;
  left: 50%;
  transform: translateX(-50%);
  width: 900px;
  height: 460px;
  background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.2), transparent 70%);
  pointer-events: none;
  z-index: -1;
}

/* =========================================================
   TOP BAR & NAVIGATION
   ========================================================= */

.top-bar,
.subpage-nav {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 20px 24px 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  z-index: 50;
}

.subpage-nav {
  justify-content: space-between;
  padding-top: 0;
  margin-bottom: 36px;
}

.lang-switcher {
  position: relative;
}

.lang-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 13px;
  border-radius: 10px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.lang-toggle:hover {
  background: var(--bg-surface-hover);
  border-color: var(--border-strong);
}

.globe-icon {
  width: 16px;
  height: 16px;
  color: var(--text-secondary);
}

.chevron-small {
  width: 14px;
  height: 14px;
  color: var(--text-secondary);
  transition: transform 0.2s ease;
}

.lang-switcher.open .chevron-small {
  transform: rotate(180deg);
}

.lang-menu {
  display: none;
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  min-width: 170px;
  max-height: 240px;
  overflow-y: auto;
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: 12px;
  padding: 6px;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
  z-index: 100;
}

.lang-switcher.open .lang-menu {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.lang-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 0.875rem;
  text-align: left;
  cursor: pointer;
  color: var(--text-secondary);
  transition: background 0.15s ease, color 0.15s ease;
}

.lang-option:hover,
.lang-option.active {
  background: var(--bg-surface-hover);
  color: var(--text-primary);
}

.lang-option.active {
  font-weight: 600;
  color: #60a5fa;
}

.lang-code {
  font-size: 0.75rem;
  color: var(--text-muted);
}

/* =========================================================
   HERO & SHOWCASE (HOME)
   ========================================================= */

.hero-section {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 44px 24px 64px;
  text-align: center;
  flex: 1;
}

.hero-content {
  max-width: 680px;
  margin: 0 auto 48px;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(59, 130, 246, 0.3);
  color: #93c5fd;
  font-size: 0.82rem;
  font-weight: 600;
}

.badge[hidden] {
  display: none;
}

.badge-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
}

.badge-metric {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.3);
  color: #6ee7b7;
}

.badge-metric svg {
  width: 14px;
  height: 14px;
}

.hero-content h1 {
  font-size: clamp(2.6rem, 6vw, 4rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.1;
  margin-bottom: 16px;
  background: linear-gradient(135deg, #ffffff 30%, #93c5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  font-size: 1.125rem;
  color: var(--text-secondary);
  margin-bottom: 32px;
  line-height: 1.65;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}

.cta-primary,
.cta-secondary,
.real-download-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 13px 24px;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 600;
  transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}

.cta-primary svg,
.cta-secondary svg,
.real-download-btn svg {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.cta-secondary svg {
  fill: currentColor;
}

.back-home-btn svg {
  fill: none;
}

.cta-primary,
.real-download-btn {
  background: var(--accent);
  color: #ffffff;
  box-shadow: 0 6px 24px rgba(59, 130, 246, 0.35);
}

.cta-primary:hover,
.real-download-btn:hover {
  background: var(--accent-hover);
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(59, 130, 246, 0.45);
}

.cta-secondary {
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  color: var(--text-primary);
}

.cta-secondary:hover {
  background: var(--bg-surface-hover);
  border-color: rgba(255, 255, 255, 0.28);
  transform: translateY(-2px);
}

.star-pill {
  font-size: 0.8rem;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: #fbbf24;
}

.star-pill[hidden] {
  display: none;
}

/* Screenshot Showcase */
.showcase-wrapper {
  max-width: 920px;
  margin: 0 auto;
}

.screenshot-container {
  background: var(--bg-surface);
  border: 1px solid var(--border-strong);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
}

#app-screenshot {
  width: 100%;
  height: auto;
  display: block;
}

.screenshot-placeholder {
  display: none;
  padding: 64px 24px;
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.screenshot-thumbs {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.thumb-btn {
  padding: 7px 14px;
  border-radius: 999px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
}

.thumb-btn.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;
}

/* =========================================================
   DOWNLOADS PAGE & ACCORDION
   ========================================================= */

.downloads-section {
  width: 100%;
  max-width: 880px;
  margin: 0 auto;
  padding: 24px 24px 64px;
  flex: 1;
}

.section-header {
  text-align: center;
  margin-bottom: 36px;
}

.section-header h1 {
  font-size: clamp(2rem, 4.5vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  margin-bottom: 12px;
}

.section-header p {
  color: var(--text-secondary);
  font-size: 1.02rem;
}

.accordion-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.accordion-item {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.accordion-item:hover,
.accordion-item.open {
  border-color: var(--border-accent);
}

.accordion-header {
  width: 100%;
  background: transparent;
  border: none;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  cursor: pointer;
  text-align: left;
}

.os-info {
  display: flex;
  align-items: center;
  gap: 16px;
}

.os-icon {
  width: 34px;
  height: 34px;
  object-fit: contain;
  flex-shrink: 0;
}

.os-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.os-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.os-title {
  font-size: 1.1rem;
  font-weight: 700;
}

.recommended-tag {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(16, 185, 129, 0.15);
  color: #6ee7b7;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.recommended-tag[hidden] {
  display: none;
}

.os-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.chevron {
  width: 20px;
  height: 20px;
  color: var(--text-secondary);
  flex-shrink: 0;
  transition: transform 0.22s ease;
}

.accordion-item.open .chevron {
  transform: rotate(180deg);
}

.accordion-body {
  display: none;
  border-top: 1px solid var(--border-subtle);
}

.accordion-item.open .accordion-body {
  display: block;
}

.accordion-content {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.real-download-btn {
  align-self: flex-start;
}

.install-guide {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.guide-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.guide-block {
  min-width: 0;
}

.guide-block h4 {
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-primary);
}

.guide-block ol {
  padding-left: 20px;
  color: var(--text-secondary);
  font-size: 0.9rem;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.guide-block code {
  background: var(--bg-code);
  border: 1px solid var(--border-subtle);
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 0.82rem;
  color: #93c5fd;
}

.code-box {
  position: relative;
  background: var(--bg-code);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 14px 46px 14px 14px;
}

.code-box pre {
  overflow-x: auto;
  font-size: 0.8rem;
  line-height: 1.55;
  color: #cbd5e1;
  padding-bottom: 6px;
}

.code-box pre code {
  background: transparent;
  border: none;
  padding: 0;
  color: inherit;
  font-size: inherit;
}

.code-box pre::-webkit-scrollbar,
.lang-menu::-webkit-scrollbar {
  height: 5px;
  width: 5px;
}

.code-box pre::-webkit-scrollbar-track,
.lang-menu::-webkit-scrollbar-track {
  background: transparent;
}

.code-box pre::-webkit-scrollbar-thumb,
.lang-menu::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999px;
}

.code-box pre::-webkit-scrollbar-thumb:hover,
.lang-menu::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.32);
}

.code-box pre::-webkit-scrollbar-button,
.lang-menu::-webkit-scrollbar-button {
  display: none;
  width: 0;
  height: 0;
}

.copy-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 30px;
  height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 7px;
  cursor: pointer;
  color: var(--text-secondary);
  transition: all 0.15s ease;
}

.copy-btn:hover {
  color: var(--text-primary);
  border-color: var(--border-strong);
}

.copy-btn.copied {
  color: var(--emerald);
  border-color: rgba(16, 185, 129, 0.45);
}

.copy-btn svg {
  width: 15px;
  height: 15px;
}

.smartscreen-notice {
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.28);
  border-radius: 12px;
  padding: 16px 18px;
  font-size: 0.88rem;
  color: var(--text-secondary);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.smartscreen-notice strong {
  color: #fbbf24;
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
  width: 100%;
  border-top: 1px solid var(--border-subtle);
  padding: 24px;
  text-align: center;
  font-size: 0.875rem;
  color: var(--text-muted);
  margin-top: auto;
}

footer a {
  color: var(--text-secondary);
  text-decoration: underline;
  text-underline-offset: 3px;
}

footer a:hover {
  color: var(--text-primary);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 768px) {
  .accordion-header {
    padding: 16px 18px;
  }

  .accordion-content {
    padding: 18px;
  }

  .real-download-btn {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .hero-actions a {
    width: 100%;
  }
}
